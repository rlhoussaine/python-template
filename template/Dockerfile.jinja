# syntax=docker/dockerfile:1.7

# uv is declared as a stage (instead of `COPY --from=<image>`) so that both
# Dependabot and Renovate can track and bump its version.
FROM ghcr.io/astral-sh/uv:0.11.8 AS uv

# ── Builder ──────────────────────────────────────────────────────────────────
FROM python:{{ python_version }}-slim-bookworm AS builder

COPY --from=uv /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/local/bin/python{{ python_version }} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Layer 1: third-party dependencies only (cache invalidated only by uv.lock).
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --no-default-groups --no-editable

# Layer 2: the project itself, installed as a regular (non-editable) wheel
# into the virtualenv, so the prod stage needs nothing but /app/.venv.
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --no-editable

# ── Dev ──────────────────────────────────────────────────────────────────────
FROM builder AS dev

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --all-groups

ENV PATH="/app/.venv/bin:$PATH"
ENTRYPOINT ["/bin/bash"]

# ── Prod (no uv, no sources, non-root) ───────────────────────────────────────
FROM python:{{ python_version }}-slim-bookworm AS prod

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --shell /usr/sbin/nologin appuser
WORKDIR /app

COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv

USER appuser
ENTRYPOINT ["python", "-m", "{{ project_slug }}"]
{% if use_cli %}
CMD ["--help"]
{% endif %}
