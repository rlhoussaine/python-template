{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Changing the Python minor version is a deliberate decision, not a routine bump",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Group non-major Python dependency updates",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python dependencies"
    }
  ],
  "customManagers": [
    {
      "description": "uv image version used by .gitlab-ci.yml",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.gitlab-ci\\.yml$/"],
      "matchStrings": ["UV_VERSION: \"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/astral-sh/uv",
      "versioningTemplate": "semver"
    }
  ]
}
