name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ '{{' }} github.workflow {{ '}}' }}-${{ '{{' }} github.ref {{ '}}' }}
  cancel-in-progress: true

jobs:
  # ── Code quality ─────────────────────────────────────────────────────
  quality:
    name: Lint & Type Check
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Install uv and Python
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          python-version: "{{ python_version }}"
          enable-cache: true

      # --locked fails if uv.lock is out of date with pyproject.toml.
      - name: Install dependencies
        run: uv sync --locked --all-groups

      - name: Ruff (format + lint)
        run: |
          uv run ruff format --check src/ tests/
          uv run ruff check --output-format=github src/ tests/

      - name: ty
        run: uv run ty check src/

      - name: deptry
        run: uv run deptry src/

      - name: pip-audit
        run: uv run pip-audit --skip-editable
{% if use_docs %}

      - name: Build documentation
        run: uv run mkdocs build --strict
{% endif %}

  # ── Tests ────────────────────────────────────────────────────────────────
  test:
    name: Tests (Python ${{ '{{' }} matrix.python-version {{ '}}' }})
    runs-on: ubuntu-latest
    timeout-minutes: 15
    strategy:
      fail-fast: false
      matrix:
        # Every supported version from requires-python (>={{ python_version }}).
        python-version: {{ python_versions | tojson }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Install uv and Python ${{ '{{' }} matrix.python-version {{ '}}' }}
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          python-version: ${{ '{{' }} matrix.python-version {{ '}}' }}
          enable-cache: true

      - name: Install dependencies
        run: uv sync --locked --all-groups

      - name: Run tests
        run: uv run pytest --cov --cov-report=term --cov-report=xml

      - name: Upload coverage
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: coverage-${{ '{{' }} matrix.python-version {{ '}}' }}
          path: coverage.xml
          if-no-files-found: ignore
