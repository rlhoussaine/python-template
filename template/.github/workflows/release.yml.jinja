name: Release

# release-please opens/updates a release PR from Conventional Commits; merging
# it creates the tag + GitHub release. A release created with GITHUB_TOKEN does
# NOT trigger other workflows (`on: release` would never fire), so everything
# that must happen on release is chained here, gated on `release_created`.
on:
  push:
    branches: [main]

permissions: {}

concurrency:
  group: release-${{ '{{' }} github.ref {{ '}}' }}
  cancel-in-progress: false

jobs:
  release-please:
    name: Release PR / tag
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
      pull-requests: write
    outputs:
      release_created: ${{ '{{' }} steps.rp.outputs.release_created {{ '}}' }}
      tag_name: ${{ '{{' }} steps.rp.outputs.tag_name {{ '}}' }}
    steps:
      # Configuration: release-please-config.json + .release-please-manifest.json
      - uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7 # v5.0.0
        id: rp

  build:
    name: Build, SBOM & provenance
    needs: release-please
    if: needs.release-please.outputs.release_created == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write # upload assets to the GitHub release
      id-token: write # sign the provenance attestation
      attestations: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ '{{' }} needs.release-please.outputs.tag_name {{ '}}' }}
          persist-credentials: false

      - name: Install uv and Python
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          python-version: "{{ python_version }}"

      - name: Build distributions
        run: uv build

      - name: Generate CycloneDX SBOM (runtime dependencies)
        run: uv export --quiet --locked --no-default-groups --format cyclonedx1.5 --output-file sbom.cdx.json

      - name: Attest build provenance
        uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8 # v4.2.2
        with:
          subject-path: dist/*

      - name: Attach distributions and SBOM to the release
        env:
          GH_TOKEN: ${{ '{{' }} github.token {{ '}}' }}
          TAG: ${{ '{{' }} needs.release-please.outputs.tag_name {{ '}}' }}
        run: gh release upload "$TAG" dist/* sbom.cdx.json --repo "$GITHUB_REPOSITORY"

      - name: Upload distributions
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: dist
          path: dist/
          if-no-files-found: error
{% if publish_package %}

  publish:
    name: Publish to PyPI (Trusted Publishing)
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment:
      name: pypi
      url: https://pypi.org/p/{{ project_slug }}
    permissions:
      id-token: write # OIDC token exchanged for a short-lived PyPI token
    steps:
      - name: Download distributions
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: dist
          path: dist/

      - name: Publish to PyPI
        uses: pypa/gh-action-pypi-publish@dc37677b2e1c63e2034f94d8a5b11f265b73ba33 # v1.14.2
{% endif %}
